{$LISTEN_ADDRESS::8080} {
	encode zstd gzip

	redir / /web/ 302

	# Plugin discovery and embedded HTML/JS are Jellyfin endpoints, not web files.
	@pluginConfiguration path_regexp pluginConfiguration (?i)^/web/configurationpages?$
	route {
		handle /api/community/* {
			reverse_proxy community:3096
		}

		handle @pluginConfiguration {
			reverse_proxy {$JELLYFIN_UPSTREAM:http://jellyfin:8096}
		}

		handle_path /web/* {
			root * /srv/jellyfin-web
			header Cache-Control "no-cache"
			header /assets/* Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		handle {
			reverse_proxy {$JELLYFIN_UPSTREAM:http://jellyfin:8096}
		}
	}
}
