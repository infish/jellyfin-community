@@ -0,0 +1,71 @@
+import { afterEach, expect, test, vi } from 'vitest';
+
+vi.mock('./api', () => ({
+    communityFetch: vi.fn(),
+    profileAvatar: () => document.createElement('span')
+}));
+vi.mock('./presence', () => ({ heartbeat: vi.fn(async () => undefined) }));
+
+import { communityFetch } from './api';
+import { OnlinePanel } from './online';
+
+afterEach(() => {
+    vi.restoreAllMocks();
+    document.body.innerHTML = '';
+});
+
+test('invisible removes the current user and green light immediately after saving', async () => {
+    vi.spyOn(document, 'visibilityState', 'get').mockReturnValue('visible');
+    const me = { id: 'self', name: 'Self', presenceVisible: true };
+    vi.mocked(communityFetch).mockImplementation(async path => {
+        if (path === '/presence/preference') return { visible: false };
+        if (path === '/me') return { ...me, presenceVisible: false };
+        return { users: [] };
+    });
+    const host = document.createElement('aside');
+    document.body.append(host);
+    const panel = new OnlinePanel(host);
+    panel.active = true;
+    panel.me = me;
+    panel.renderUsers([{ id: 'self', name: 'Self' }]);
+    await panel.setInvisible(true);
+    expect(host.querySelector('.communityOnlineCount')?.textContent).toBe('0');
+    expect(host.querySelector('.communityOnlineUsers')?.children.length).toBe(0);
+    expect(host.querySelector('.communityOfflineDot')).not.toBeNull();
+    expect(host.querySelector<HTMLInputElement>('input')?.checked).toBe(true);
+    expect(communityFetch).toHaveBeenCalledWith('/presence/preference', {
+        method: 'PUT', body: JSON.stringify({ visible: false })
+    });
+    panel.pause();
+});
+
+test('a stale presence read cannot relight the user after hiding', async () => {
+    vi.spyOn(document, 'visibilityState', 'get').mockReturnValue('visible');
+    const me = { id: 'self', name: 'Self', presenceVisible: true };
+    let release: ((value: typeof me) => void) | undefined;
+    const stale = new Promise<typeof me>(resolve => {
+        release = resolve;
+    });
+    let reads = 0;
+    vi.mocked(communityFetch).mockImplementation(async path => {
+        if (path === '/me') {
+            reads++;
+            return reads === 1 ? stale : { ...me, presenceVisible: false };
+        }
+        if (path === '/presence/preference') return { visible: false };
+        return { users: [{ id: 'self', name: 'Self' }] };
+    });
+    const host = document.createElement('aside');
+    document.body.append(host);
+    const panel = new OnlinePanel(host);
+    panel.active = true;
+    panel.me = { ...me };
+    panel.renderUsers([{ id: 'self', name: 'Self' }]);
+    const reading = panel.refresh();
+    await panel.setInvisible(true);
+    release?.(me);
+    await reading;
+    await vi.waitFor(() => expect(host.querySelector('.communityOnlineCount')?.textContent).toBe('0'));
+    expect(host.querySelector<HTMLInputElement>('input')?.checked).toBe(true);
+    panel.pause();
+});
diff --git a/src/scripts/community/presence.js b/src/scripts/community/presence.js
new file mode 100644
index 0000000..632a1d3
--- /dev/null
+++ b/src/scripts/community/presence.js
@@ -0,0 +1,103 @@
+import { communityFetch, createId } from './api';
+import './community.scss';
+
+/* eslint-disable @stylistic/max-statements-per-line */
+
+let timer;
+let pollTimer;
+let sessionId;
+let button;
+let dialog;
+
+function getSessionId() {
+    if (!sessionId) {
+        sessionId = sessionStorage.getItem('communityPresenceSession') || createId();
+        sessionStorage.setItem('communityPresenceSession', sessionId);
+    }
+    return sessionId;
+}
+
+export async function heartbeat() {
+    if (document.visibilityState !== 'visible') return;
+    try {
+        await communityFetch('/presence/heartbeat', { method: 'PUT', body: JSON.stringify({ sessionId: getSessionId() }) });
+    } catch (error) {
+        console.debug('Community presence unavailable', error);
+    }
+}
+
+function renderUsers(users) {
+    const list = dialog?.querySelector('.communityPresenceList');
+    if (!list) return;
+    list.innerHTML = '';
+    list.append(...users.map(user => {
+        const row = document.createElement('li');
+        const avatar = document.createElement('span');
+        avatar.className = 'communityInitials';
+        avatar.textContent = user.name.trim().slice(0, 1).toUpperCase() || '?';
+        const name = document.createElement('span');
+        name.textContent = user.name;
+        row.append(avatar, name);
+        return row;
+    }));
+    if (!users.length) {
+        const empty = document.createElement('li');
+        empty.textContent = 'Nobody is visible right now';
+        list.append(empty);
+    }
+}
+
+async function poll() {
+    if (document.visibilityState !== 'visible') return;
+    try {
+        const { users } = await communityFetch('/presence');
+        button?.classList.remove('communityUnavailable');
+        if (button) {
+            button.querySelector('.communityPresenceCount').textContent = String(users.length);
+            button.setAttribute('aria-label', `Online in this web client: ${users.length}`);
+            button.title = `Online in this web client: ${users.length}`;
+        }
+        renderUsers(users);
+    } catch {
+        button?.classList.add('communityUnavailable');
+        if (button) {
+            button.querySelector('.communityPresenceCount').textContent = '?';
+            button.setAttribute('aria-label', 'Online presence unavailable');
+        }
+    }
+}
+
+function ensureDialog() {
+    if (dialog) return dialog;
+    dialog = document.createElement('dialog');
+    dialog.className = 'communityPresenceDialog';
+    dialog.innerHTML = '<form method="dialog"><button class="communityDialogClose" aria-label="Close">×</button><h2>Online in this web client</h2><ul class="communityPresenceList"></ul><a href="#/community">Open Community</a></form>';
+    dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
+    document.body.append(dialog);
+    return dialog;
+}
+
+function visibilityChanged() {
+    if (document.visibilityState === 'visible') {
+        void heartbeat();
+        void poll();
+    }
+}
+
+export function initializePresence(headerButton) {
+    if (button === headerButton) return;
+    button = headerButton;
+    button.addEventListener('click', () => { ensureDialog().showModal(); void poll(); });
+    clearInterval(timer);
+    clearInterval(pollTimer);
+    document.removeEventListener('visibilitychange', visibilityChanged);
+    document.addEventListener('visibilitychange', visibilityChanged);
+    document.removeEventListener('communitypresencechange', poll);
+    document.addEventListener('communitypresencechange', poll);
+    void heartbeat();
+    void poll();
+    timer = setInterval(heartbeat, 30_000);
+    pollTimer = setInterval(poll, 5_000);
+}
+
+/* eslint-enable @stylistic/max-statements-per-line */
diff --git a/src/scripts/community/preview.js b/src/scripts/community/preview.js
