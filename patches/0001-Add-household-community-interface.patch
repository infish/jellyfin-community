@@ -0,0 +1,35 @@
+import { playbackManager } from 'components/playback/playbackmanager';
+import Events from 'utils/events';
+import { EventType } from 'constants/eventType';
+
+// Keep Messages above the bottom controls and subtitle region during local video.
+export class PlaybackChatPosition {
+    /** @param {HTMLElement} root @param {{isPlayingVideo: Function, getCurrentPlayer?: Function}} manager */
+    constructor(root,manager=playbackManager) {
+        this.root=root; this.manager=manager; this.home=root.parentElement; this.controlsVisible=true;
+        this.osd=(_event,visible)=> {this.controlsVisible=visible; this.update();};
+        Events.on(document,EventType.SHOW_VIDEO_OSD,this.osd);
+        this.start=(_event,player)=> {this.playing=!!player?.isLocalPlayer && !player?.isExternalPlayer && manager.isPlayingVideo(player); this.update();};
+        this.stop=()=> {this.playing=false; this.update();};
+        this.fullscreen=()=>this.update();
+        Events.on(manager,'playbackstart',this.start); Events.on(manager,'playbackstop',this.stop);
+        document.addEventListener('fullscreenchange',this.fullscreen); document.addEventListener('webkitfullscreenchange',this.fullscreen);
+        const player=manager.getCurrentPlayer?.();
+        this.playing=!!player?.isLocalPlayer && !player?.isExternalPlayer && manager.isPlayingVideo(player); this.update();
+    }
+    update() {
+        this.root.classList.toggle('communityChatPlayback',this.playing);
+        this.root.classList.toggle('communityChatControlsHidden',this.playing && !this.controlsVisible);
+        const fullscreen=document.fullscreenElement || document.webkitFullscreenElement;
+        // Native video fullscreen cannot contain web overlays. Do not reparent into a video element.
+        const target=this.playing && fullscreen instanceof HTMLElement && !['VIDEO','IFRAME'].includes(fullscreen.tagName) ? fullscreen : this.home;
+        if(target && target!==this.root && this.root.parentElement!==target) target.append(this.root);
+    }
+    destroy() {
+        Events.off(document,EventType.SHOW_VIDEO_OSD,this.osd);
+        Events.off(this.manager,'playbackstart',this.start); Events.off(this.manager,'playbackstop',this.stop);
+        document.removeEventListener('fullscreenchange',this.fullscreen); document.removeEventListener('webkitfullscreenchange',this.fullscreen);
+        this.root.classList.remove('communityChatPlayback','communityChatControlsHidden');
+        if(this.home && this.root.parentElement!==this.home) this.home.append(this.root);
+    }
+}
