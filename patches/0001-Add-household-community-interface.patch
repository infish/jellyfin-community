+import { communityFetch, messageAvatar } from './api';
+import { OnlinePanel } from './online';
+import { HoldAdvance } from './holdAdvance';
+import 'elements/emby-scrollbuttons/emby-scrollbuttons.scss';
+import './community.scss';
+
+/* eslint-disable @stylistic/max-statements-per-line, no-void, sonarjs/pseudo-random */
+
+export class CommunityPreview {
+    constructor(container) {
+        this.container = container;
+        this.timer = null;
+        this.items = [];
+        this.rendered = 0;
+        this.cursor = null;
+        this.browsing = false;
+        this.loadingOlder = false;
+        this.hold = new HoldAdvance(isActive => this.advance(isActive));
+        this.release = () => this.hold.stop();
+        container.classList.add('communityPreviewLayout');
+        this.content = document.createElement('div');
+        this.content.className = 'communityPreviewMessages';
+        const onlineHost = document.createElement('aside');
+        onlineHost.className = 'communityOnlinePanel';
+        onlineHost.setAttribute('aria-label', 'People online');
+        container.append(this.content, onlineHost);
+        this.online = new OnlinePanel(onlineHost);
+    }
+    async refresh() {
+        if (this.browsing || document.visibilityState !== 'visible' || !this.container?.isConnected) return;
+        try {
+            const data = await communityFetch('/messages');
+            this.items = data.items;
+            this.cursor = data.nextCursor;
+            this.rendered = Math.min(3, this.items.length);
+            const items = this.items.slice(0, this.rendered);
+            this.content.innerHTML = '';
+            const heading = document.createElement('div');
+            heading.className = 'sectionTitleContainer sectionTitleContainer-cards padded-left';
+            const link = document.createElement('a');
+            link.setAttribute('is', 'emby-linkbutton');
+            link.className = 'button-flat button-flat-mini sectionTitleTextButton';
+            link.href = '#/community';
+            link.setAttribute('aria-label', 'Open Community');
+            const title = document.createElement('h2');
+            title.className = 'sectionTitle sectionTitle-cards';
+            title.textContent = 'Community';
+            const chevron = document.createElement('span');
+            chevron.className = 'material-icons chevron_right';
+            chevron.setAttribute('aria-hidden', 'true');
+            link.append(title, chevron);
+            heading.append(link);
+            const controls = document.createElement('div');
+            controls.className = 'communitySliderControls';
+            const back = document.createElement('button');
+            back.type = 'button';
+            back.className = 'paper-icon-button-light emby-scrollbuttons-button communitySliderArrow';
+            this.back = back;
+            back.setAttribute('aria-label', 'Show newer messages');
+            back.innerHTML = '<span class="material-icons chevron_left" aria-hidden="true"></span>';
+            back.addEventListener('click', () => {
+                this.hold.stop();
+                this.scroller.scrollLeft = Math.max(0, this.scroller.scrollLeft - this.cardWidth() * 5);
+            });
+            this.next = document.createElement('button');
+            this.next.type = 'button';
+            this.next.className = 'paper-icon-button-light emby-scrollbuttons-button communitySliderArrow';
+            this.next.setAttribute('aria-label', 'Hold to show up to five older messages');
+            this.next.title = 'Hold to show up to five older messages';
+            this.next.innerHTML = '<span class="material-icons chevron_right" aria-hidden="true"></span>';
+            this.next.addEventListener('pointerdown', event => {
+                if (event.button !== 0) return;
+                this.browsing = true;
+                this.hold.start();
+            });
+            this.next.addEventListener('click', event => {
+                if (event.detail === 0) {
+                    this.browsing = true;
+                    this.hold.start();
+                }
+            });
+            controls.append(back, this.next);
+            heading.append(controls);
+
+            const scroller = document.createElement('div');
+            scroller.className = 'communityPreviewScroller padded-left padded-right';
+            this.scroller = scroller;
+            scroller.addEventListener('scroll', () => this.updateArrow());
+            items.forEach(message => { scroller.append(this.card(message)); });
+            if (!items.length) {
+                const empty = document.createElement('a');
+                empty.href = '#/community';
+                empty.className = 'communityPreviewCard communityPreviewEmpty';
+                empty.innerHTML = '<span class="material-icons forum" aria-hidden="true"></span><strong>Start the conversation</strong><span>Open the household message board</span>';
+                scroller.append(empty);
+            }
+            this.content.append(heading, scroller);
+            this.updateArrow();
+        } catch {
+            this.content.textContent = 'Community preview unavailable';
+            this.content.classList.add('communityMuted');
+        }
+    }
+    card(message) {
+        const card = document.createElement('a');
+        card.href = '#/community';
+        card.className = 'communityPreviewCard';
+        const author = document.createElement('strong');
+        author.textContent = message.displayName;
+        const text = document.createElement('span');
+        text.textContent = message.body;
+        const time = document.createElement('time');
+        time.dateTime = new Date(message.createdAt).toISOString();
+        time.textContent = new Date(message.createdAt).toLocaleString([], { dateStyle: 'short', timeStyle: 'short' });
+        const identity = document.createElement('div');
+        identity.className = 'communityMessageIdentity';
+        identity.append(messageAvatar(message), author);
+        card.append(identity, text, time);
+        return card;
+    }
+    cardWidth() {
+        return (this.scroller?.querySelector('.communityPreviewCard')?.getBoundingClientRect().width || 300) + 16;
+    }
+    updateArrow() {
+        this.back.disabled = this.scroller.scrollLeft <= 2;
+        this.next.disabled = this.rendered >= this.items.length && !this.cursor && this.scroller.scrollLeft >= this.scroller.scrollWidth - this.scroller.clientWidth - 2;
+    }
+    async advance(isActive) {
+        if (!this.scroller?.isConnected || this.loadingOlder) return false;
+        try {
+            if (this.scroller.scrollLeft < this.scroller.scrollWidth - this.scroller.clientWidth - 2) {
+                this.scroller.scrollLeft += this.cardWidth();
+                this.updateArrow();
+                return true;
+            }
+            if (this.rendered >= this.items.length && this.cursor) {
+                this.loadingOlder = true;
+                const data = await communityFetch(`/messages?cursor=${encodeURIComponent(this.cursor)}`);
+                const ids = new Set(this.items.map(item => item.id));
+                this.items.push(...data.items.filter(item => !ids.has(item.id)));
+                this.cursor = data.nextCursor;
+                this.loadingOlder = false;
+                // Release, pause or navigation during the fetch must not move the slider.
+                if (!isActive() || !this.scroller.isConnected) return false;
+            }
+            if (this.rendered < this.items.length) {
+                this.scroller.append(this.card(this.items[this.rendered++]));
+            } else {
+                this.next.disabled = true;
+                return false;
+            }
+            this.scroller.scrollLeft += this.cardWidth();
+            this.updateArrow();
+            return true;
+        } catch {
+            this.loadingOlder = false;
+            this.next.title = 'Could not load older messages. Try again.';
+            return false;
+        }
+    }
+    resume() { this.browsing = false; window.addEventListener('pointerup', this.release); window.addEventListener('pointercancel', this.release); window.addEventListener('blur', this.release); this.online.resume(); void this.refresh(); clearInterval(this.timer); this.timer = setInterval(() => void this.refresh(), 30_000 + Math.floor(Math.random() * 2500)); }
+    pause() { this.hold.stop(); window.removeEventListener('pointerup', this.release); window.removeEventListener('pointercancel', this.release); window.removeEventListener('blur', this.release); this.online.pause(); clearInterval(this.timer); this.timer = null; }
+    destroy() { this.pause(); this.container?.remove(); this.container = null; }
+}
+
+/* eslint-enable @stylistic/max-statements-per-line, no-void, sonarjs/pseudo-random */
