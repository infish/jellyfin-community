+++ b/src/scripts/community/online.js
@@ -0,0 +1,142 @@
+import { communityFetch, profileAvatar } from './api';
+import { heartbeat } from './presence';
+import { updateOnline, openChat, action } from './socialWidgets';
+import { initializeChat } from './chat';
+
+export class OnlinePanel {
+    constructor(container) {
+        initializeChat();
+        this.container = container;
+        this.timer = null;
+        this.active = false;
+        this.usersKey = null;
+        this.loading = false;
+        this.changing = false;
+        this.revision = 0;
+        this.me = null;
+        this.users = [];
+        this.refreshPending = false;
+        container.classList.add('communityOnlinePanel');
+        container.innerHTML = '<div class="communityOnlineHeading"><span class="communityOnlineDot" aria-hidden="true"></span><h2>Online now</h2><span class="communityOnlineCount"></span></div><p class="communityOnlineDescription">In this web client</p><ul class="communityOnlineUsers"></ul><p class="communityOnlineStatus" role="status">Loading…</p><div class="communityPrivacyControl"><label><span class="material-icons visibility_off" aria-hidden="true"></span><span>Remain invisible</span><input type="checkbox" role="switch" aria-label="Remain invisible" disabled></label><p class="communityPrivacyHint" role="status">Checking your visibility…</p></div>';
+        this.input = container.querySelector('.communityPrivacyControl input');
+        this.input.addEventListener('change', () => this.setInvisible(this.input.checked));
+        this.preferenceChanged = () => {
+            this.usersKey = null;
+            updateOnline([]);
+            this.refresh();
+        };
+        this.visibility = () => {
+            if (this.active && document.visibilityState === 'visible') {
+                this.refresh();
+            }
+        };
+    }
+
+    async refresh() {
+        if (!this.active || document.visibilityState !== 'visible') return;
+        if (this.loading || this.changing) {
+            this.refreshPending = true;
+            return;
+        }
+        this.loading = true;
+        const revision = this.revision;
+        try {
+            const [me, { users }] = await Promise.all([communityFetch('/me'), communityFetch('/presence')]);
+            if (!this.active || revision !== this.revision) return;
+            this.me = me;
+            this.input.checked = !me.presenceVisible;
+            this.input.disabled = false;
+            this.updatePrivacyHint();
+            this.renderUsers(users);
+        } catch {
+            if (!this.active || revision !== this.revision) return;
+            this.usersKey = null;
+            this.container.querySelector('.communityOnlineUsers').innerHTML = '';
+            this.container.querySelector('.communityOnlineCount').textContent = '—';
+            this.container.querySelector('.communityOnlineStatus').textContent = 'Online presence unavailable';
+        } finally {
+            this.loading = false;
+            if (this.refreshPending && !this.changing) {
+                this.refreshPending = false;
+                this.refresh();
+            }
+        }
+    }
+
+    updatePrivacyHint() {
+        this.container.querySelector('.communityPrivacyHint').textContent = this.me.presenceVisible ? 'You appear online' : 'You appear offline until you turn this off';
+    }
+
+    async setInvisible(invisible) {
+        if (!this.me || this.changing) return;
+        this.changing = true;
+        this.revision++;
+        this.input.disabled = true;
+        this.container.querySelector('.communityPrivacyHint').textContent = 'Saving…';
+        try {
+            await communityFetch('/presence/preference', { method: 'PUT', body: JSON.stringify({ visible: !invisible }) });
+            this.me.presenceVisible = !invisible;
+            this.input.checked = invisible;
+            this.usersKey = null;
+            this.renderUsers(this.users);
+            this.updatePrivacyHint();
+            if (!invisible) await heartbeat();
+            document.dispatchEvent(new CustomEvent('communitypresencechange', { detail: { visible: !invisible } }));
+        } catch {
+            this.input.checked = !this.me.presenceVisible;
+            this.container.querySelector('.communityPrivacyHint').textContent = 'Could not save visibility. Please try again.';
+        } finally {
+            this.changing = false;
+            this.input.disabled = false;
+            this.refresh();
+        }
+    }
+
+    renderUsers(publishedUsers) {
+        const users = publishedUsers.filter(user => user.id !== this.me?.id || this.me.presenceVisible);
+        this.users = users;
+        updateOnline(users);
+        const key = JSON.stringify(users.map(user => [user.id, user.name]));
+        if (this.usersKey === key) return;
+        this.usersKey = key;
+        const list = this.container.querySelector('.communityOnlineUsers');
+        list.innerHTML = '';
+        users.forEach(user => {
+            const row = document.createElement('li');
+            const portrait = document.createElement('span');
+            portrait.className = 'communityOnlinePortrait';
+            portrait.appendChild(profileAvatar(user.name, `/presence/${encodeURIComponent(user.id)}/avatar`));
+            const dot = document.createElement('span');
+            dot.className = 'communityOnlineDot';
+            dot.setAttribute('aria-hidden', 'true');
+            portrait.appendChild(dot);
+            const name = document.createElement('span');
+            name.textContent = user.name;
+            const message = action('Message', () => openChat(user));
+            message.setAttribute('aria-label', `Message ${user.name}`);
+            row.append(portrait, name);
+            if (user.id !== this.me?.id) row.append(message);
+            list.appendChild(row);
+        });
+        this.container.querySelector('.communityOnlineCount').textContent = String(users.length);
+        this.container.querySelector('.communityOnlineStatus').textContent = users.length ? '' : 'Nobody is visible right now';
+        this.container.querySelector('.communityOnlineHeading > .communityOnlineDot').classList.toggle('communityOfflineDot', !users.length);
+    }
+
+    resume() {
+        this.pause();
+        this.active = true;
+        document.addEventListener('visibilitychange', this.visibility);
+        document.addEventListener('communitypresencechange', this.preferenceChanged);
+        heartbeat().then(() => this.refresh());
+        this.timer = setInterval(() => this.refresh(), 5_000);
+    }
+
+    pause() {
+        this.active = false;
+        clearInterval(this.timer);
+        this.timer = null;
+        document.removeEventListener('visibilitychange', this.visibility);
+        document.removeEventListener('communitypresencechange', this.preferenceChanged);
+    }
+}
