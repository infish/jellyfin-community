+import { communityFetch, createId, profileAvatar } from './api';
+import { PlaybackChatPosition } from './playbackPosition';
+import { EmojiPicker } from './emojiPicker';
+import { renderEmojiText } from './emojiDisplay';
+import { action, onlineDot, quotePreview, reactionBar, visibleMessageIds } from './socialWidgets';
+import './community.scss';
+
+export class ChatDock {
+    constructor() {
+        this.me = null;
+        this.conversations = [];
+        this.current = null;
+        this.items = [];
+        this.drafts = new Map();
+        this.reply = null;
+        this.cursor = null;
+        this.revision = 0;
+        this.busy = false;
+        this.sending = false;
+        this.root = document.createElement('section');
+        this.root.className = 'communityChatDock';
+        this.root.hidden = true;
+        this.root.setAttribute('aria-label', 'Private messages');
+        this.launcher = action('Messages', () => this.openInbox(), 'communityChatLauncher');
+        this.panel = document.createElement('div');
+        this.panel.className = 'communityChatPanel'; this.panel.hidden = true;
+        this.panel.innerHTML = '<header class="communityChatHeader"><div class="communityChatTitle"></div><div class="communityChatControls"></div></header><div class="communityChatInbox"></div><div class="communityChatThread" hidden><div class="communityChatSettings"></div><button type="button" class="communityChatOlder" hidden>Load older messages</button><div class="communityChatMessages" role="log" aria-label="Conversation messages"></div><form class="communityChatComposer communityComposer"><div class="communityChatReply"></div><label for="communityChatInput">Message</label><textarea id="communityChatInput" required rows="2" maxlength="1000"></textarea><div class="communityComposerFooter"><button type="button" class="communityEmojiToggle" aria-label="Choose chat emoji" aria-expanded="false"><span>🙂</span> Emoji</button><span class="communityChatLength">0 / 500</span><button type="submit" class="communityChatSend">Send</button></div><div class="communityEmojiPicker" role="group" aria-label="Choose a chat emoji" hidden></div></form></div><p class="communityChatError" role="status"></p>';
+        this.root.append(this.panel, this.launcher); document.body.append(this.root);
+        this.playbackPosition=new PlaybackChatPosition(this.root);
+        this.input = this.panel.querySelector('textarea');
+        this.picker = new EmojiPicker(this.panel, message => this.error(message));
+        this.input.addEventListener('input', () => {
+            const count = [...this.input.value].length;
+            this.panel.querySelector('.communityChatLength').textContent = `${count} / 500`;
+            this.input.setCustomValidity(count > 500 ? 'Your message is limited to 500 characters.' : '');
+            if (this.current) this.drafts.set(this.current.id, { body:this.input.value,reply:this.reply });
+            this.retry = null;
+        });
+        this.input.addEventListener('keydown', event => {
+            if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) { event.preventDefault(); this.panel.querySelector('form').requestSubmit(); }
+        });
+        this.panel.querySelector('form').addEventListener('submit', event => { event.preventDefault(); void this.send(); });
+        this.panel.querySelector('.communityChatOlder').addEventListener('click', () => void this.loadOlder());
+        this.openHandler = event => void this.openPerson(event.detail);
+        document.addEventListener('communityopenchat', this.openHandler);
+        this.visibilityHandler = () => { if (document.visibilityState === 'visible') void this.refresh(); };
+        document.addEventListener('visibilitychange', this.visibilityHandler);
+        this.timer = setInterval(() => void this.refresh(), 5_000);
+        this.refresh();
+    }
+    error(message = '') { this.panel.querySelector('.communityChatError').textContent = message; }
+    saveDraft() { if (this.current) this.drafts.set(this.current.id,{body:this.input.value,reply:this.reply}); }
+    reset() {
+        this.revision++; this.current = null; this.items = []; this.conversations = []; this.reply = null; this.retry = null;
+        this.drafts.clear(); this.input.value = ''; this.panel.hidden = true; this.launcher.textContent = 'Messages';
+        this.panel.querySelector('.communityChatMessages').replaceChildren(); this.panel.querySelector('.communityChatInbox').replaceChildren();
+        this.picker.close();
+    }
+    async refresh() {
+        if (this.busy || document.visibilityState !== 'visible') return;
+        this.busy = true;
+        const revision = this.revision;
+        try {
+            const me = await communityFetch('/me');
+            if (revision !== this.revision) return;
+            if (this.me && this.me.id !== me.id) this.reset();
+            this.me = me;
+            this.root.hidden = false;
+            const currentRevision = this.revision;
+            const { items } = await communityFetch('/conversations');
+            if (currentRevision !== this.revision) return;
+            this.conversations = items;
+            const unread = items.filter(c => !c.muted && !c.blocked).reduce((sum,c) => sum + c.unread,0);
+            this.launcher.textContent = unread ? `Messages · ${unread}` : 'Messages';
+            this.launcher.setAttribute('aria-label', `Messages, ${unread} unread`);
+            if (!this.panel.hidden && !this.current) this.renderInbox();
+            if (!this.panel.hidden && this.current) {
+                const conversation = items.find(c => c.id === this.current.id);
+                if (conversation) { this.current = conversation; this.renderSettings(); }
+                const data = await communityFetch(`/conversations/${this.current.id}/messages`);
+                if (currentRevision !== this.revision || this.panel.hidden || !this.current) return;
+                const merged = new Map(this.items.map(m => [m.id,m])); data.items.forEach(m => merged.set(m.id,m));
+                const latestIds=new Set(data.items.map(m=>m.id));
+                const host=this.panel.querySelector('.communityChatMessages');
+                const olderIds=visibleMessageIds(host,host).filter(id=>!latestIds.has(id));
+                if (olderIds.length) {
+                    const snapshot=await communityFetch(`/conversations/${this.current.id}/snapshot`,{method:'POST',body:JSON.stringify({ids:olderIds})});
+                    if (currentRevision!==this.revision) return;
+                    snapshot.items.forEach(m=>merged.set(m.id,m));
+                }
+                const next = [...merged.values()].sort((a,b) => a.seq-b.seq);
+                if (JSON.stringify(next) !== JSON.stringify(this.items)) { this.items = next; this.renderMessages(false); }
+                await this.clearUnread();
+            }
+            this.error();
+        } catch (error) {
+            // Hide private history if the current Jellyfin session is unavailable.
+            if (/Sign in|401|authorization|token/i.test(error.message)) { this.reset(); this.me = null; this.root.hidden=true; }
+            else if (!this.panel.hidden) this.error(error.message);
+        } finally { this.busy = false; }
+    }
+    header(title) {
+        const heading = this.panel.querySelector('.communityChatTitle'); heading.replaceChildren();
+        if (this.current) heading.append(profileAvatar(this.current.peer.name, `/conversations/${this.current.id}/avatar`));
+        const label = document.createElement('strong'); label.textContent = title; heading.append(label);
+        if (this.current) heading.append(onlineDot(this.current.peer.id));
+        const controls = this.panel.querySelector('.communityChatControls'); controls.replaceChildren();
+        if (this.current) controls.append(action('‹', () => this.openInbox()));
+        const close = action('×', () => { this.saveDraft(); this.panel.hidden = true; this.picker.close(); this.revision++; this.launcher.focus(); });
+        close.setAttribute('aria-label','Close messages'); controls.append(close);
+    }
+    openInbox() {
+        this.saveDraft(); this.revision++; this.current = null; this.panel.hidden = false;
+        this.panel.querySelector('.communityChatInbox').hidden = false;
+        this.panel.querySelector('.communityChatThread').hidden = true;
+        this.picker.close(); this.header('Messages'); this.renderInbox(); this.refresh();
+    }
+    renderInbox() {
+        const host = this.panel.querySelector('.communityChatInbox'); host.replaceChildren();
+        for (const c of this.conversations) {
+            const row = action('', () => void this.select(c), 'communityConversation');
+            row.append(profileAvatar(c.peer.name,`/conversations/${c.id}/avatar`));
+            const content = document.createElement('span'); const name = document.createElement('strong'); name.textContent = c.peer.name;
+            name.append(onlineDot(c.peer.id));
+            const preview = document.createElement('span'); renderEmojiText(preview,c.last?.body || 'Start a conversation');
+            content.append(name,preview); row.append(content);
+            if (c.unread) { const badge = document.createElement('b'); badge.textContent = String(c.unread); badge.className = 'communityUnreadBadge'; row.append(badge); }
+            if (c.muted || c.blocked) { const state = document.createElement('small'); state.textContent = c.blocked ? 'Blocked' : 'Muted'; row.append(state); }
+            host.append(row);
+        }
+        if (!this.conversations.length) { const empty = document.createElement('p'); empty.textContent = 'Choose Message beside someone in Online now to start a private chat.'; host.append(empty); }
+    }
+    async openPerson(person) {
+        try {
+            const me = await communityFetch('/me');
+            if (person.id === me.id) return;
+            if (this.me && this.me.id!==me.id) this.reset();
+            const { id } = await communityFetch('/conversations',{method:'POST',body:JSON.stringify({peerId:person.id})});
+            const { items } = await communityFetch('/conversations');
+            this.me = me; this.conversations = items;
+            await this.select(items.find(c => c.id === id));
+        } catch (error) { this.panel.hidden = false; this.error(error.message); }
+    }
+    async select(conversation) {
+        if (!conversation || this.sending) return;
+        this.saveDraft(); this.revision++; const revision = this.revision;
+        this.current = conversation; this.items = []; this.cursor = null; this.retry = null;
+        this.panel.hidden = false; this.panel.querySelector('.communityChatInbox').hidden = true;
+        this.panel.querySelector('.communityChatThread').hidden = false;
+        this.header(conversation.peer.name); this.renderSettings(); this.picker.close(); this.error();
+        const draft = this.drafts.get(conversation.id);
+        this.reply = draft?.reply || null; this.input.value = draft?.body || ''; this.input.dispatchEvent(new Event('input'));
+        this.renderReply(); this.panel.querySelector('.communityChatMessages').replaceChildren();
+        try {
+            const data = await communityFetch(`/conversations/${conversation.id}/messages`);
+            if (revision !== this.revision) return;
+            this.items = data.items; this.cursor = data.nextCursor; this.renderMessages(true); await this.clearUnread();
+            this.input.focus();
+        } catch (error) { if (revision === this.revision) this.error(error.message); }
+    }
+    renderSettings() {
+        const c = this.current; if (!c) return;
+        this.input.disabled = !c.canSend;
+        this.panel.querySelector('.communityChatSend').disabled = !c.canSend || this.sending;
+        this.panel.querySelector('.communityEmojiToggle').disabled = !c.canSend;
+        if (!c.canSend) this.picker.close();
+        if (this.renderedPermission!==c.canSend) {
+            this.renderedPermission=c.canSend;
+            if (this.items.length) this.renderMessages(false);
+        }
+        const host = this.panel.querySelector('.communityChatSettings'); host.replaceChildren();
+        const save = async (muted,blocked) => {
+            try {
+                await communityFetch(`/conversations/${c.id}/settings`,{method:'PUT',body:JSON.stringify({muted,blocked})});
+                c.muted = muted; c.blocked = blocked;
+                if (blocked) c.canSend = false;
+                this.renderSettings(); this.refresh();
