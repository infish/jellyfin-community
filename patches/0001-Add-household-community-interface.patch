diff --git a/src/scripts/community/emojiPicker.js b/src/scripts/community/emojiPicker.js
new file mode 100644
index 0000000..cd0e16c
--- /dev/null
+++ b/src/scripts/community/emojiPicker.js
@@ -0,0 +1,80 @@
+const FACES = [
+    ['😀', 'Grinning face'], ['😃', 'Happy face'], ['😄', 'Smiling face'], ['😁', 'Beaming face'],
+    ['😆', 'Laughing face'], ['😅', 'Smiling with sweat'], ['😂', 'Tears of joy'], ['🤣', 'Rolling with laughter'],
+    ['🙂', 'Slight smile'], ['🙃', 'Upside-down face'], ['😉', 'Winking face'], ['😊', 'Blushing smile'],
+    ['😇', 'Smiling with halo'], ['🥰', 'Smiling with hearts'], ['😍', 'Heart eyes'], ['😘', 'Blowing a kiss'],
+    ['😋', 'Savoring food'], ['😛', 'Tongue out'], ['😎', 'Sunglasses'], ['🤔', 'Thinking face'],
+    ['😐', 'Neutral face'], ['🙄', 'Rolling eyes'], ['😢', 'Crying face'], ['😭', 'Loudly crying face'],
+    ['😮', 'Surprised face'], ['😴', 'Sleeping face'], ['😬', 'Grimacing face'], ['😡', 'Angry face']
+];
+
+export function insertEmoji(input, emoji) {
+    const start = input.selectionStart ?? input.value.length;
+    const end = input.selectionEnd ?? start;
+    const value = input.value.slice(0, start) + emoji + input.value.slice(end);
+    if ([...value].length > 500) return false;
+    input.value = value;
+    input.focus();
+    input.setSelectionRange(start + emoji.length, start + emoji.length);
+    input.dispatchEvent(new Event('input', { bubbles: true }));
+    return true;
+}
+
+export class EmojiPicker {
+    constructor(view, onError) {
+        this.input = view.querySelector('textarea');
+        this.toggle = view.querySelector('.communityEmojiToggle');
+        this.panel = view.querySelector('.communityEmojiPicker');
+        this.toggleClick = () => this.setOpen(this.panel.hidden);
+        this.escape = event => {
+            if (event.key === 'Escape') {
+                this.close();
+                this.toggle.focus();
+            }
+        };
+        this.outside = event => {
+            if (!this.panel.contains(event.target) && !this.toggle.contains(event.target)) this.close();
+        };
+        [['Faces', FACES], ['Extras', [['🇮🇱', 'Israel flag'], ['🧃', 'Juice box']]]].forEach(([name, emojis]) => {
+            const heading = document.createElement('h3');
+            heading.textContent = name;
+            const grid = document.createElement('div');
+            grid.className = 'communityEmojiGrid';
+            emojis.forEach(([emoji, label]) => {
+                const button = document.createElement('button');
+                button.type = 'button';
+                button.className = 'communityEmojiChoice';
+                button.textContent = emoji;
+                button.title = label;
+                button.setAttribute('aria-label', label);
+                button.addEventListener('click', () => {
+                    if (!insertEmoji(this.input, emoji)) onError('Your message is limited to 500 characters.');
+                });
+                grid.appendChild(button);
+            });
+            this.panel.append(heading, grid);
+        });
+        this.toggle.addEventListener('click', this.toggleClick);
+    }
+
+    setOpen(open) {
+        this.close();
+        if (!open) return;
+        this.panel.hidden = false;
+        this.toggle.setAttribute('aria-expanded', 'true');
+        document.addEventListener('keydown', this.escape);
+        document.addEventListener('pointerdown', this.outside);
+    }
+
+    close() {
+        this.panel.hidden = true;
+        this.toggle.setAttribute('aria-expanded', 'false');
+        document.removeEventListener('keydown', this.escape);
+        document.removeEventListener('pointerdown', this.outside);
+    }
+
+    destroy() {
+        this.close();
+        this.toggle.removeEventListener('click', this.toggleClick);
+    }
+}
diff --git a/src/scripts/community/emojiPicker.test.ts b/src/scripts/community/emojiPicker.test.ts
new file mode 100644
index 0000000..37d6ba7
--- /dev/null
+++ b/src/scripts/community/emojiPicker.test.ts
@@ -0,0 +1,29 @@
+import { expect, test } from 'vitest';
+import { insertEmoji } from './emojiPicker';
+
+test('emoji insertion replaces the selection and restores the cursor', () => {
+    const input = document.createElement('textarea');
+    input.value = 'hello world';
+    input.setSelectionRange(6, 11);
+    expect(insertEmoji(input, '🧃')).toBe(true);
+    expect(input.value).toBe('hello 🧃');
+    expect(input.selectionStart).toBe(8);
+});
+
+test('the limit counts Unicode code points instead of UTF-16 units', () => {
+    const input = document.createElement('textarea');
+    input.value = '😀'.repeat(499);
+    input.setSelectionRange(input.value.length, input.value.length);
+    expect(insertEmoji(input, '🧃')).toBe(true);
+    expect([...input.value]).toHaveLength(500);
+    expect(insertEmoji(input, '😀')).toBe(false);
+    expect([...input.value]).toHaveLength(500);
+});
+
+test('the two-code-point flag cannot push the message past the limit', () => {
+    const input = document.createElement('textarea');
+    input.value = 'a'.repeat(499);
+    input.setSelectionRange(499, 499);
+    expect(insertEmoji(input, '🇮🇱')).toBe(false);
+    expect(input.value).toHaveLength(499);
+});
diff --git a/src/scripts/community/holdAdvance.js b/src/scripts/community/holdAdvance.js
new file mode 100644
index 0000000..14bc3bc
--- /dev/null
+++ b/src/scripts/community/holdAdvance.js
@@ -0,0 +1,28 @@
+/** One press advances at most five cards; release cancels all pending movement. */
+export class HoldAdvance {
+    constructor(step) {
+        this.step = step;
+        this.timer = null;
+        this.generation = 0;
+    }
+
+    start() {
+        this.stop();
+        const generation = this.generation;
+        let remaining = 5;
+        const advance = async () => {
+            if (generation !== this.generation || remaining === 0) return;
+            remaining--;
+            const moved = await this.step(() => generation === this.generation);
+            if (generation !== this.generation || !moved || remaining === 0) return;
+            this.timer = setTimeout(advance, 220);
+        };
+        advance();
+    }
+
+    stop() {
+        this.generation++;
+        clearTimeout(this.timer);
+        this.timer = null;
+    }
+}
