diff --git a/src/scripts/community/requestBoard.js b/src/scripts/community/requestBoard.js
new file mode 100644
index 0000000..556c08f
--- /dev/null
+++ b/src/scripts/community/requestBoard.js
@@ -0,0 +1,87 @@
+import { communityFetch, profileAvatar } from './api';
+import { action } from './socialWidgets';
+import './community.scss';
+
+export const REQUEST_STATUS = { requested:'Requested',in_progress:'In progress',available:'Available',declined:'Declined' };
+export function requestPoster(item) {
+    if (!item.posterUrl) return null;
+    const poster=profileAvatar(item.title,item.posterUrl.replace('/api/community',''));
+    poster.classList.remove('communityInitials'); poster.classList.add('requestBoardPoster');
+    return poster;
+}
+export function requestCard(item,me,onChange,onError,compact=false) {
+    const card=document.createElement('article'); card.className='requestBoardCard';
+    const identity=document.createElement('a'); identity.href='#/request-media'; identity.className='requestBoardIdentity';
+    const poster=requestPoster(item); if (poster) identity.append(poster);
+    const title=document.createElement('strong'); title.textContent=`${item.title}${item.year ? ` (${item.year})` : ''}`;
+    const type=document.createElement('span'); type.className='communityMuted'; type.textContent=item.mediaType==='tv' ? 'Show' : 'Movie';
+    const heading=document.createElement('div'); heading.append(title,type); identity.append(heading); card.append(identity);
+    if(!compact && me?.isAdmin) {
+        const identifiers=document.createElement('div'); identifiers.className='requestIdentifiers';
+        const button=action('Title IDs',async()=> {
+            button.disabled=true;
+            try {
+                const data=await communityFetch(`/request-board/${item.requests[0].id}/identifiers`);
+                identifiers.replaceChildren();
+                for(const [label,id,url] of [['IMDb',data.imdb,data.imdbUrl],['TMDB',data.tmdb,data.tmdbUrl]]) {
+                    if(!id || !url) continue;
+                    const link=document.createElement('a'); link.textContent=`${label}: ${id}`; link.href=url; link.target='_blank'; link.rel='noopener noreferrer';
+                    const copy=action(`Copy ${label} ID`,async()=> {try {await navigator.clipboard.writeText(id); copy.textContent='Copied';} catch {onError(`Copy this ID: ${id}`);}});
+                    identifiers.append(link,copy);
+                }
+                if(!data.imdb) {const note=document.createElement('small'); note.textContent='No IMDb ID supplied by the catalogue.'; identifiers.append(note);}
+            } catch(error) {button.disabled=false; onError(error.message);}
+        }); identifiers.append(button); card.append(identifiers);
+    }
+    for (const request of compact ? item.requests.slice(0,3) : item.requests) {
+        const row=document.createElement('div'); row.className='requestBoardPerson';
+        const name=document.createElement('span'); name.textContent=request.displayName;
+        const status=document.createElement('span'); status.className=`requestBoardStatus ${request.status}`; status.textContent=REQUEST_STATUS[request.status] || 'Requested';
+        row.append(name,status);
+        if(request.removeAfter) {const cleanup=document.createElement('small'); cleanup.className='requestCleanupDate'; cleanup.textContent=`Leaves board ${new Date(request.removeAfter).toLocaleString()} if still available`; row.append(cleanup);}
+        if (request.seasons.length) {const seasons=document.createElement('small'); seasons.textContent=`Seasons ${request.seasons.join(', ')}`; row.append(seasons);}
+        if (!compact) {
+            const time=document.createElement('time'); time.dateTime=new Date(request.createdAt).toISOString(); time.textContent=new Date(request.createdAt).toLocaleDateString(); row.append(time);
+            if (me?.isAdmin) {
+                const select=document.createElement('select'); select.setAttribute('aria-label',`Status for ${item.title}, requested by ${request.displayName}`);
+                Object.entries(REQUEST_STATUS).forEach(([value,label])=> {const option=document.createElement('option'); option.value=value; option.textContent=label; select.append(option);});
+                select.value=request.status;
+                select.addEventListener('change',async()=> {
+                    select.disabled=true;
+                    try {await communityFetch(`/request-board/${request.id}/status`,{method:'PUT',body:JSON.stringify({status:select.value})}); await onChange();}
+                    catch(error) {select.value=request.status; onError(error.message);} finally {select.disabled=false;}
+                }); row.append(select);
+            }
+            if (request.canRemove) row.append(action(request.authorId===me?.id ? 'Remove my request' : 'Remove request',async()=> {
+                try {await communityFetch(`/request-board/${request.id}`,{method:'DELETE'}); await onChange();} catch(error) {onError(error.message);}
+            }));
+        }
+        card.append(row);
+    }
+    if (compact && item.requests.length>3) {const more=document.createElement('small'); more.textContent=`+${item.requests.length-3} more requesters`; card.append(more);}
+    return card;
+}
+
+export class RequestBoardPreview {
+    constructor(container) {
+        this.container=container; this.active=false; this.loading=false; this.key=null; this.revision=0;
+        container.className='verticalSection requestBoardPreview';
+        container.innerHTML='<div class="sectionTitleContainer sectionTitleContainer-cards padded-left"><a class="button-flat button-flat-mini sectionTitleTextButton requestBoardTitle" href="#/request-media"><h2 class="sectionTitle sectionTitle-cards">Requests</h2><span class="material-icons chevron_right" aria-hidden="true"></span></a><a href="#/request-media?add=1" class="communityAction requestBoardAdd">+ Add request</a></div><div class="requestBoardPreviewCards padded-left padded-right"></div><p class="requestBoardPreviewStatus communityMuted padded-left" role="status"></p>';
+    }
+    async refresh() {
+        if (!this.active || this.loading || document.visibilityState!=='visible') return;
+        this.loading=true;
+        const revision=this.revision;
+        try {
+            const data=await communityFetch('/request-board'); if (!this.active || revision!==this.revision) return;
+            const key=JSON.stringify(data.items); if (key===this.key) return; this.key=key;
+            const host=this.container.querySelector('.requestBoardPreviewCards'); host.replaceChildren();
+            host.append(...data.items.slice(0,5).map(item=>requestCard(item,null,null,null,true)));
+            this.container.querySelector('.requestBoardPreviewStatus').textContent=data.items.length ? '' : 'No requests yet. Add a movie or show you would like to watch.';
+        } catch(error) {if (revision===this.revision) {this.key=null; this.container.querySelector('.requestBoardPreviewCards').replaceChildren(); this.container.querySelector('.requestBoardPreviewStatus').textContent=error.message;}}
+        finally {this.loading=false;}
+    }
+    resume() {this.pause(); this.active=true; this.loading=false; this.key=null; this.container.querySelector('.requestBoardPreviewCards').replaceChildren(); this.refresh(); this.timer=setInterval(()=>void this.refresh(),15000);}
+    pause() {this.active=false; this.revision++; clearInterval(this.timer);}
+    destroy() {this.pause(); this.container.remove();}
+}
