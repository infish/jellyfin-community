+    const checkbox=view.querySelector<HTMLInputElement>('.requestManualCheck')!; checkbox.checked=true; checkbox.dispatchEvent(new Event('change'));
+    expect(view.querySelector<HTMLButtonElement>('.requestConfirm')!.disabled).toBe(false);
