diff --git a/src/scripts/community/emojiDisplay.js b/src/scripts/community/emojiDisplay.js
new file mode 100644
index 0000000..569594e
--- /dev/null
+++ b/src/scripts/community/emojiDisplay.js
@@ -0,0 +1,30 @@
+// Original vector artwork: keep the Unicode flag in storage, render it independently of OS fonts.
+const FLAG = '🇮🇱';
+const SVG_NS = 'http://www.w3.org/2000/svg';
+
+function flagImage() {
+    const svg = document.createElementNS(SVG_NS, 'svg');
+    svg.setAttribute('viewBox', '0 0 66 48');
+    svg.setAttribute('role', 'img');
+    svg.setAttribute('aria-label', 'Israel flag');
+    svg.classList.add('communityFlagEmoji');
+    const shapes = [
+        ['rect', { width: '66', height: '48', fill: '#fff' }],
+        ['path', { d: 'M0 8H66M0 40H66', stroke: '#0038b8', 'stroke-width': '6' }],
+        ['path', { d: 'M33 14L42 29H24ZM33 34L24 19H42Z', fill: 'none', stroke: '#0038b8', 'stroke-width': '1.8', 'stroke-linejoin': 'round' }]
+    ];
+    shapes.forEach(([tag, attrs]) => {
+        const shape = document.createElementNS(SVG_NS, tag);
+        Object.entries(attrs).forEach(([key, value]) => shape.setAttribute(key, value));
+        svg.appendChild(shape);
+    });
+    return svg;
+}
+
+export function renderEmojiText(element, text) {
+    element.replaceChildren();
+    text.split(FLAG).forEach((part, index) => {
+        if (index) element.appendChild(flagImage());
+        element.appendChild(document.createTextNode(part));
+    });
+}
