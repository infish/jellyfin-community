new file mode 100644
index 0000000..fbd4fc4
--- /dev/null
+++ b/src/scripts/community/api.js
@@ -0,0 +1,67 @@
+import { ServerConnections } from 'lib/jellyfin-apiclient';
+
+/* eslint-disable sonarjs/pseudo-random */
+
+const ROOT = '/api/community';
+const avatarCache = new Map();
+
+function token() {
+    const value = ServerConnections.currentApiClient()?.accessToken();
+    if (!value) throw new Error('Sign in to use community features');
+    return value;
+}
+
+export async function communityFetch(path, options = {}) {
+    const headers = {
+        ...(options.headers || {}),
+        Authorization: `Bearer ${token()}`
+    };
+    if (options.body) headers['Content-Type'] = 'application/json';
+    const response = await fetch(`${ROOT}${path}`, { ...options, headers, credentials: 'same-origin' });
+    const data = await response.json().catch(() => ({}));
+    if (!response.ok) throw new Error(data.error || `Community service returned ${response.status}`);
+    return data;
+}
+
+export function createId() {
+    if (crypto.randomUUID) return crypto.randomUUID();
+    return `${Date.now()}-${Math.random().toString(36).slice(2)}-${Math.random().toString(36).slice(2)}`;
+}
+
+export function messageAvatar(message) {
+    return profileAvatar(message.displayName, `/messages/${encodeURIComponent(message.id)}/avatar`);
+}
+
+export function profileAvatar(name, path) {
+    const avatar = document.createElement('span');
+    avatar.className = 'communityAvatar communityInitials';
+    avatar.setAttribute('aria-hidden', 'true');
+    avatar.textContent = name.trim().slice(0, 1).toUpperCase() || '?';
+    const accessToken=token();
+    const key=`${accessToken}:${path}`;
+    let cached=avatarCache.get(key);
+    if (!cached || cached.expires<Date.now()) {
+        if (avatarCache.size>200) avatarCache.clear();
+        const promise=fetch(`${ROOT}${path}`, {
+            headers: { Authorization: `Bearer ${accessToken}` }, credentials: 'same-origin'
+        }).then(response => {
+        if (!response.ok) throw new Error('No profile picture');
+        return response.blob();
+        });
+        cached={promise,expires:Date.now()+60_000}; avatarCache.set(key,cached);
+    }
+    cached.promise.then(blob => {
+        if (!avatar.isConnected) return;
+        const url = URL.createObjectURL(blob);
+        const image = document.createElement('img');
+        image.alt = '';
+        image.onload = () => URL.revokeObjectURL(url);
+        image.onerror = () => URL.revokeObjectURL(url);
+        image.src = url;
+        avatar.textContent = '';
+        avatar.appendChild(image);
+    }).catch(() => { /* Keep initials when the author has no accessible image. */ });
+    return avatar;
+}
+
+/* eslint-enable sonarjs/pseudo-random */
