diff --git a/src/scripts/community/chat.test.ts b/src/scripts/community/chat.test.ts
new file mode 100644
index 0000000..09b57e4
--- /dev/null
+++ b/src/scripts/community/chat.test.ts
@@ -0,0 +1,70 @@
+import { afterEach, expect, test, vi } from 'vitest';
+vi.mock('./playbackPosition',()=>({PlaybackChatPosition:class {destroy() {}}}));
+vi.mock('./api', () => ({ communityFetch:vi.fn(),createId:()=> 'aaaaaaaaaaaaaaaa',profileAvatar:()=>document.createElement('span') }));
+import { communityFetch } from './api';
+import { ChatDock } from './chat';
+
+let dock: ChatDock | undefined;
+afterEach(()=> { dock?.destroy(); dock=undefined; vi.restoreAllMocks(); document.body.replaceChildren(); });
+
+function setup() {
+    vi.spyOn(document,'visibilityState','get').mockReturnValue('visible');
+    let self='self';
+    const conversation={id:'conversation',peer:{id:'peer',name:'Peer'},unread:1,muted:false,blocked:false,canSend:true};
+    const message={id:'message',seq:1,authorId:'peer',displayName:'Peer',body:'Hello',createdAt:1700000000000,reply:null,reactions:[]};
+    vi.mocked(communityFetch).mockImplementation(async (path,options={})=> {
+        if (path==='/me') return {id:self,name:self};
+        if (path==='/conversations') return {items:[{...conversation}]};
+        if (path.endsWith('/messages')) {
+            if ((options as RequestInit).method==='POST') return {...message,id:'sent',seq:2,authorId:self,body:JSON.parse((options as RequestInit).body as string).body};
+            return {items:[message],nextCursor:null};
+        }
+        if (path.endsWith('/unread')) return {ok:true};
+        return {items:[],ok:true};
+    });
+    dock=new ChatDock();
+    return {conversation,message,changeUser:()=> {self='other';}};
+}
+
+test('drafts and replies survive closing; private chat has no read receipt',async()=> {
+    const {conversation}=setup();
+    await vi.waitFor(()=>expect(dock?.me?.id).toBe('self'));
+    await dock!.select(conversation);
+    dock!.input!.value='Draft 🧃'; dock!.input!.dispatchEvent(new Event('input'));
+    const reply=[...dock!.root.querySelectorAll('button')].find(b=>b.textContent==='Reply')!;
+    reply.click();
+    dock!.root.querySelector<HTMLButtonElement>('[aria-label="Close messages"]')!.click();
+    await dock!.select(conversation);
+    expect(dock!.input!.value).toBe('Draft 🧃');
+    expect(dock!.reply?.id).toBe('message');
+    expect(dock!.root.textContent).not.toMatch(/\bseen\b|read receipt/i);
+    const paths=vi.mocked(communityFetch).mock.calls.map(([path])=>path);
+    expect(paths).toContain('/conversations/conversation/unread');
+});
+
+test('switching Jellyfin accounts removes private drafts and messages',async()=> {
+    const {conversation,changeUser}=setup();
+    await vi.waitFor(()=>expect(dock?.busy).toBe(false));
+    await dock!.select(conversation);
+    dock!.input!.value='private draft'; dock!.input!.dispatchEvent(new Event('input'));
+    changeUser(); await dock!.refresh();
+    expect(dock!.current).toBeNull(); expect(dock!.drafts.size).toBe(0);
+    expect(dock!.input!.value).toBe(''); expect(dock!.panel.hidden).toBe(true);
+    expect(dock!.panel.querySelector('.communityChatMessages')!.textContent).toBe('');
+});
+
+test('a failed send can be retried without creating another message identifier',async()=> {
+    const {conversation}=setup();
+    await vi.waitFor(()=>expect(dock?.busy).toBe(false)); await dock!.select(conversation);
+    dock!.input!.value='hello'; dock!.input!.dispatchEvent(new Event('input'));
+    const original=vi.mocked(communityFetch).getMockImplementation()!;
+    let failed=false;
+    vi.mocked(communityFetch).mockImplementation(async(path,options)=> {
+        if (path.endsWith('/messages') && (options as RequestInit)?.method==='POST' && !failed) {failed=true; throw new Error('Disconnected');}
+        return original(path,options);
+    });
+    await dock!.send(); expect(dock!.input!.value).toBe('hello');
+    await dock!.send(); expect(dock!.input!.value).toBe('');
+    const sends=vi.mocked(communityFetch).mock.calls.filter(([path,options])=>path.endsWith('/messages') && (options as RequestInit)?.method==='POST');
+    expect(sends).toHaveLength(2); expect((sends[0][1] as RequestInit)?.body).toBe((sends[1][1] as RequestInit)?.body);
+});
