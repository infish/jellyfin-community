+++ b/src/apps/legacy/controllers/community.html
@@ -0,0 +1,19 @@
+<div id="communityPage" data-role="page" class="page libraryPage communityPage" data-title="Community">
+    <h1>Community</h1>
+    <p class="communityMuted">A shared plain-text board for this household.</p>
+    <div class="communityBoardLayout">
+    <div class="communityBoardMain">
+    <label><input class="presencePreference" type="checkbox"> Show me as online in this web client</label>
+    <form class="communityComposer">
+        <label for="communityMessageBody">New message</label>
+        <textarea id="communityMessageBody" required></textarea>
+        <div class="communityComposerFooter"><div class="communityComposerTools"><button type="button" class="communityEmojiToggle" aria-label="Choose emoji" aria-expanded="false" aria-controls="communityEmojiPicker"><span aria-hidden="true">🙂</span> Emoji</button><span class="communityCharacterCount">0 / 500</span></div><button is="emby-button" type="submit" class="raised button-submit emby-button">Post</button></div>
+        <div id="communityEmojiPicker" class="communityEmojiPicker" role="group" aria-label="Choose an emoji" hidden></div>
+    </form>
+    <p class="communityError" role="status"></p>
+    <ul class="communityMessages"></ul>
+    <button is="emby-button" type="button" class="communityLoadMore raised emby-button hide">Load older messages</button>
+    </div>
+    <aside class="communityOnlinePanel" aria-label="People online"></aside>
+    </div>
+</div>
