--- /dev/null
+++ b/src/scripts/community/holdAdvance.test.ts
@@ -0,0 +1,29 @@
+import { afterEach, expect, test, vi } from 'vitest';
+import { HoldAdvance } from './holdAdvance';
+
+afterEach(() => vi.useRealTimers());
+
+test('a held arrow stops after exactly five advances', async () => {
+    vi.useFakeTimers();
+    const step = vi.fn(async () => true);
+    const hold = new HoldAdvance(step);
+    hold.start();
+    await vi.runAllTimersAsync();
+    expect(step).toHaveBeenCalledTimes(5);
+    await vi.advanceTimersByTimeAsync(10_000);
+    expect(step).toHaveBeenCalledTimes(5);
+});
+
+test('releasing during an in-flight step cannot schedule more movement', async () => {
+    vi.useFakeTimers();
+    let finish: ((value: boolean) => void) | undefined;
+    const step = vi.fn(() => new Promise<boolean>(resolve => {
+        finish = resolve;
+    }));
+    const hold = new HoldAdvance(step);
+    hold.start();
+    hold.stop();
+    finish?.(true);
+    await vi.runAllTimersAsync();
+    expect(step).toHaveBeenCalledTimes(1);
+});
