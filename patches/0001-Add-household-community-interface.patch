@@ -0,0 +1,104 @@
+import { communityFetch } from './api';
+import { FACES, EXTRAS } from './emojiPicker';
+import { renderEmojiText } from './emojiDisplay';
+
+let online = new Set();
+export function updateOnline(users) {
+    online = new Set(users.map(user => user.id));
+    document.querySelectorAll('[data-community-author]').forEach(dot => {
+        const visible = online.has(dot.dataset.communityAuthor);
+        dot.hidden = !visible;
+        dot.setAttribute('aria-label', visible ? 'Online' : 'Offline');
+    });
+}
+export function onlineDot(id) {
+    const dot = document.createElement('span');
+    dot.className = 'communityOnlineDot communityAuthorDot';
+    dot.dataset.communityAuthor = id;
+    dot.setAttribute('role', 'img');
+    dot.setAttribute('aria-label', online.has(id) ? 'Online' : 'Offline');
+    dot.hidden = !online.has(id);
+    return dot;
+}
+export function openChat(user) {
+    document.dispatchEvent(new CustomEvent('communityopenchat', { detail: user }));
+}
+export function action(label, callback, className = '') {
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.className = `communityAction ${className}`;
+    button.textContent = label;
+    button.addEventListener('click', callback);
+    return button;
+}
+export function visibleMessageIds(container, viewport = null) {
+    const bounds = viewport?.getBoundingClientRect() || { top:0,bottom:window.innerHeight };
+    return [...container.querySelectorAll('[data-message-id]')].filter(row => {
+        const rect=row.getBoundingClientRect();
+        return rect.bottom>=bounds.top && rect.top<=bounds.bottom;
+    }).slice(0,200).map(row=>row.dataset.messageId);
+}
+export function quotePreview(reply, jump) {
+    const quote = action('', () => { if (!reply.deleted) jump(reply.id); }, 'communityQuote');
+    const name = document.createElement('strong');
+    name.textContent = reply.deleted ? 'Original message' : reply.displayName;
+    const body = document.createElement('span');
+    renderEmojiText(body, reply.body);
+    quote.append(name, body);
+    quote.disabled = !!reply.deleted;
+    quote.title = reply.deleted ? 'Message deleted' : 'Go to original message';
+    return quote;
+}
+export function reactionBar(message, scope, onError) {
+    const host = document.createElement('div');
+    host.className = 'communityReactions';
+    let pending = false;
+    const change = async (emoji, active) => {
+        if (pending) return;
+        pending = true;
+        try {
+            const result = await communityFetch(`/reactions/${scope}/${message.id}`, { method: 'PUT', body: JSON.stringify({ emoji, active }) });
+            message.reactions = result.reactions;
+            draw();
+            document.dispatchEvent(new Event('communitymessageschange'));
+        } catch (error) { onError(error.message); }
+        finally { pending = false; }
+    };
+    const draw = () => {
+        host.replaceChildren();
+        (message.reactions || []).forEach(reaction => {
+            const pill = action('', () => change(reaction.emoji, !reaction.mine), reaction.mine ? 'communityReaction mine' : 'communityReaction');
+            renderEmojiText(pill, `${reaction.emoji} ${reaction.count}`);
+            pill.setAttribute('aria-pressed', String(reaction.mine));
+            pill.setAttribute('aria-label', `${reaction.emoji}, ${reaction.count} reactions${reaction.mine ? ', including yours' : ''}`);
+            const people = reaction.people.map(p => p.name).join(', ');
+            pill.title = people;
+            const count = action(String(reaction.count), () => {
+                const names = document.createElement('p'); names.className = 'communityReactionPeople'; names.textContent = people;
+                const existing = host.querySelector('.communityReactionPeople');
+                if (existing) existing.remove(); else host.append(names);
+            });
+            // Touch users can inspect names without toggling their reaction.
+            count.setAttribute('aria-label', `Who reacted ${reaction.emoji}`);
+            count.classList.add('communityReactionCount');
+            renderEmojiText(pill, reaction.emoji);
+            host.append(pill, count);
+        });
+        const picker = document.createElement('div');
+        picker.className = 'communityReactionPicker'; picker.hidden = true;
+        picker.setAttribute('role', 'group'); picker.setAttribute('aria-label', 'Select a reaction');
+        [...FACES, ...EXTRAS].forEach(([emoji, label]) => {
+            const button = action('', () => change(emoji, !(message.reactions || []).some(r => r.emoji === emoji && r.mine)), 'communityEmojiChoice');
+            renderEmojiText(button, emoji); button.title = label; button.setAttribute('aria-label', label);
+            picker.append(button);
+        });
+        const toggle = action(scope === 'direct' ? '☺' : '☺ React', () => { picker.hidden = !picker.hidden; toggle.setAttribute('aria-expanded', String(!picker.hidden)); });
+        toggle.setAttribute('aria-label', 'React to message');
+        toggle.title = 'React to message';
+        toggle.setAttribute('aria-expanded', 'false');
+        picker.addEventListener('keydown', event => { if (event.key === 'Escape') { picker.hidden = true; toggle.focus(); toggle.setAttribute('aria-expanded','false'); } });
+        host.append(toggle, picker);
+    };
+    draw();
+    return host;
+}
