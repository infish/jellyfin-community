+
+test('request deletion controls only appear on permitted entries',()=> {
+    const item={title:'Movie',mediaType:'movie',year:2000,requests:[{id:'other',authorId:'other',displayName:'Other',seasons:[],status:'requested',createdAt:1,canRemove:false}]};
+    const card=requestCard(item,{id:'self',isAdmin:false},vi.fn(),vi.fn());
+    expect(card.textContent).not.toContain('Remove');
+    item.requests[0].canRemove=true;
+    const adminCard=requestCard(item,{id:'self',isAdmin:true},vi.fn(),vi.fn());
+    expect(adminCard.textContent).toContain('Remove request');
+    expect(adminCard.querySelector('select')).not.toBeNull();
+});
+
+test('a restricted account cannot inherit catalogue details or credentials from a previous view session',async()=> {
+    const {view}=setup(); await page!.onResume();
+    view.querySelector('.requestBoardCards')!.textContent='Previous account request';
+    view.querySelector<HTMLInputElement>('#requestTmdbToken')!.value='unsaved-private-token';
+    vi.mocked(communityFetch).mockImplementation(async()=> {throw new Error('Catalogue unavailable for this account');});
+    await page!.onResume();
+    expect(view.querySelector('.requestBoardCards')!.textContent).toBe('');
+    expect(view.querySelector<HTMLInputElement>('#requestTmdbToken')!.value).toBe('');
+    expect(view.querySelector<HTMLFormElement>('.requestTmdbSetup')!.hidden).toBe(true);
+});
+
+test('home request cards disappear when session access fails',async()=> {
+    vi.spyOn(document,'visibilityState','get').mockReturnValue('visible');
+    const host=document.createElement('section');document.body.append(host);
+    const preview=new RequestBoardPreview(host);preview.active=true;
+    host.querySelector('.requestBoardPreviewCards')!.textContent='Previous session requests';
+    vi.mocked(communityFetch).mockRejectedValue(new Error('Not permitted'));
+    await preview.refresh();
+    expect(host.querySelector('.requestBoardPreviewCards')!.textContent).toBe('');preview.destroy();
+});
+
+test('identifier controls are admin-only and available entries show their cleanup date',async()=>{
+ const item={mediaId:1,title:'Movie',mediaType:'movie',year:2000,requests:[{id:'request',authorId:'self',displayName:'Self',seasons:[],status:'available',createdAt:1,canRemove:true,removeAfter:1700000000000}]};
+ const ordinary=requestCard(item,{id:'self',isAdmin:false},vi.fn(),vi.fn());expect(ordinary.textContent).not.toContain('Title IDs');expect(ordinary.textContent).toContain('Leaves board');
+ vi.mocked(communityFetch).mockResolvedValue({imdb:'tt0117951',imdbUrl:'https://www.imdb.com/title/tt0117951/',tmdb:'1',tmdbUrl:'https://www.themoviedb.org/movie/1'});
+ const admin=requestCard(item,{id:'self',isAdmin:true},vi.fn(),vi.fn());admin.querySelector<HTMLButtonElement>('.requestIdentifiers button')!.click();await vi.waitFor(()=>expect(admin.textContent).toContain('IMDb: tt0117951'));
