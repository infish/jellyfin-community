@@ -0,0 +1,88 @@
+import { communityFetch, createId } from 'scripts/community/api';
+import 'scripts/community/community.scss';
+
+/* eslint-disable @stylistic/max-statements-per-line, no-void, sonarjs/no-nested-template-literals, sonarjs/no-unenclosed-multiline-block */
+
+export default class RequestMediaPage {
+    constructor(view) {
+        this.view = view;
+        this.selected = null;
+        this.show = () => void this.onResume();
+        view.addEventListener('viewshow', this.show);
+        this.searchTimer = null;
+        this.searchController = null;
+        this.searchHandler = event => { event.preventDefault(); void this.search(); };
+        this.typedSearch = () => {
+            clearTimeout(this.searchTimer);
+            if (view.querySelector('#requestQuery').value.trim().length >= 2) this.searchTimer = setTimeout(() => void this.search(), 300);
+        };
+        view.querySelector('.requestSearchBar').addEventListener('submit', this.searchHandler);
+        view.querySelector('#requestQuery').addEventListener('input', this.typedSearch);
+        view.querySelector('.requestConfirm').addEventListener('click', () => void this.submit());
+    }
+    error(message = '') { this.view.querySelector('.communityError').textContent = message; }
+    async onResume() { try { await this.loadMine(); } catch (error) { this.error(error.message); } }
+    async search() {
+        const q = this.view.querySelector('#requestQuery').value.trim();
+        if (q.length < 2) return;
+        this.searchController?.abort();
+        // The app entrypoint installs the project's AbortController polyfill for legacy targets.
+        // eslint-disable-next-line compat/compat
+        this.searchController = new AbortController();
+        this.error('Searching…');
+        try {
+            const data = await communityFetch(`/requests/search?q=${encodeURIComponent(q)}`, { signal: this.searchController.signal });
+            const results = this.view.querySelector('.requestResults');
+            results.innerHTML = '';
+            results.append(...data.items.map(item => {
+                const button = document.createElement('button'); button.type = 'button'; button.className = 'requestCard';
+                if (item.posterUrl) {
+                    const poster = document.createElement('img');
+                    poster.src = item.posterUrl;
+                    poster.alt = '';
+                    poster.loading = 'lazy';
+                    button.append(poster);
+                }
+                const title = document.createElement('strong'); title.textContent = item.title;
+                const meta = document.createElement('div'); meta.textContent = `${item.mediaType === 'tv' ? 'Series' : 'Movie'}${item.year ? ` · ${item.year}` : ''}`;
+                button.append(title, meta); button.addEventListener('click', () => void this.select(item)); return button;
+            }));
+            this.error(data.items.length ? '' : 'No matching movies or series.');
+        } catch (error) { if (error.name !== 'AbortError') this.error(error.message); }
+    }
+    async select(item) {
+        try {
+            this.selected = await communityFetch(`/requests/details/${item.mediaType}/${item.id}`);
+            const section = this.view.querySelector('.requestSelection'); section.classList.remove('hide');
+            section.querySelector('h2').textContent = this.selected.title;
+            section.querySelector('p').textContent = `${this.selected.mediaType === 'tv' ? 'Series' : 'Movie'}${this.selected.year ? ` · ${this.selected.year}` : ''}`;
+            const seasons = section.querySelector('.requestSeasons'); seasons.innerHTML = '';
+            if (this.selected.mediaType === 'tv') {
+                this.selected.seasons.forEach(season => {
+                    const label = document.createElement('label'); const box = document.createElement('input'); box.type = 'checkbox'; box.value = season.seasonNumber;
+                    label.append(box, document.createTextNode(` ${season.name || `Season ${season.seasonNumber}`}`)); seasons.append(label);
+                });
+            }
+            section.querySelector('.requestConfirm').focus();
+        } catch (error) { this.error(error.message); }
+    }
+    async submit() {
+        if (!this.selected) return;
+        const seasons = [...this.view.querySelectorAll('.requestSeasons input:checked')].map(x => Number(x.value));
+        try {
+            const data = await communityFetch('/requests', { method: 'POST', body: JSON.stringify({ mediaType: this.selected.mediaType, mediaId: this.selected.id, seasons, idempotencyKey: createId() }) });
+            this.error(data.state); await this.loadMine();
+        } catch (error) { this.error(error.message); }
+    }
+    async loadMine() {
+        const data = await communityFetch('/requests/mine');
+        const target = this.view.querySelector('.myRequests');
+        target.innerHTML = '';
+        target.append(...data.items.map(item => { const row = document.createElement('p'); row.textContent = `${item.title || `${item.type} request`} — ${this.status(item.status, item.mediaStatus)}`; return row; }));
+        if (!data.items.length) target.textContent = 'No requests yet.';
+    }
+    status(request, media) { if (request === 1) return 'Awaiting approval'; if (request === 3) return 'Declined'; if (request === 4) return 'Request failed'; if (media === 5) return 'Available status reported by Seerr; Jellyfin visibility check pending'; return 'Approved; awaiting availability'; }
+    destroy() { clearTimeout(this.searchTimer); this.searchController?.abort(); this.view.querySelector('.requestSearchBar')?.removeEventListener('submit', this.searchHandler); this.view.querySelector('#requestQuery')?.removeEventListener('input', this.typedSearch); this.view = null; }
+}
+
+/* eslint-enable @stylistic/max-statements-per-line, no-void, sonarjs/no-nested-template-literals, sonarjs/no-unenclosed-multiline-block */
