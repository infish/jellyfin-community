--- /dev/null
+++ b/src/apps/legacy/controllers/community.js
@@ -0,0 +1,85 @@
+import { communityFetch, messageAvatar } from 'scripts/community/api';
+import { OnlinePanel } from 'scripts/community/online';
+import { EmojiPicker } from 'scripts/community/emojiPicker';
+import 'scripts/community/community.scss';
+
+/* eslint-disable @stylistic/max-statements-per-line, no-void, sonarjs/no-nested-template-literals */
+
+export default class CommunityPage {
+    constructor(view) {
+        this.view = view;
+        this.cursor = null;
+        this.me = null;
+        this.emojiPicker = new EmojiPicker(view, message => this.setError(message));
+        view.addEventListener('viewhide', () => this.emojiPicker.close());
+        this.online = new OnlinePanel(view.querySelector('.communityOnlinePanel'));
+        view.addEventListener('viewhide', () => this.online.pause());
+        view.addEventListener('viewshow', () => {
+            this.syncPreference = event => { view.querySelector('.presencePreference').checked = event.detail.visible; };
+            document.addEventListener('communitypresencechange', this.syncPreference);
+        });
+        view.addEventListener('viewhide', () => document.removeEventListener('communitypresencechange', this.syncPreference));
+        this.show = () => void this.onResume();
+        view.addEventListener('viewshow', this.show);
+        this.submit = event => { event.preventDefault(); void this.post(); };
+        this.input = event => {
+            const length = [...event.target.value].length;
+            view.querySelector('.communityCharacterCount').textContent = `${length} / 500`;
+            event.target.setCustomValidity(length > 500 ? 'Your message is limited to 500 characters.' : '');
+        };
+        view.querySelector('.communityComposer').addEventListener('submit', this.submit);
+        view.querySelector('textarea').addEventListener('input', this.input);
+        view.querySelector('.communityLoadMore').addEventListener('click', () => void this.load(false));
+        view.querySelector('.presencePreference').addEventListener('change', event => void this.setPresence(event.target.checked));
+    }
+    setError(message = '') { this.view.querySelector('.communityError').textContent = message; }
+    async onResume() {
+        this.online.resume();
+        try {
+            this.me = await communityFetch('/me');
+            this.view.querySelector('.presencePreference').checked = this.me.presenceVisible;
+            await this.load(true);
+        } catch (error) { this.setError(error.message); }
+    }
+    async setPresence(visible) {
+        try { await communityFetch('/presence/preference', { method: 'PUT', body: JSON.stringify({ visible }) }); document.dispatchEvent(new CustomEvent('communitypresencechange', { detail: { visible } })); this.online.resume(); } catch (error) { this.setError(error.message); this.view.querySelector('.presencePreference').checked = !visible; }
+    }
+    renderMessage(message) {
+        const li = document.createElement('li');
+        li.className = 'communityMessage';
+        const header = document.createElement('div');
+        header.className = 'communityMessageHeader';
+        const author = document.createElement('strong'); author.textContent = message.displayName;
+        const time = document.createElement('time'); time.dateTime = new Date(message.createdAt).toISOString(); time.textContent = new Date(message.createdAt).toLocaleString();
+        const body = document.createElement('p'); body.className = 'communityMessageBody'; body.textContent = message.body;
+        header.append(messageAvatar(message), author, time);
+        if (message.authorId === this.me?.id || this.me?.isAdmin) {
+            const remove = document.createElement('button'); remove.type = 'button'; remove.className = 'communityMessageDelete'; remove.textContent = 'Delete';
+            remove.addEventListener('click', async () => { try { await communityFetch(`/messages/${message.id}`, { method: 'DELETE' }); li.remove(); } catch (error) { this.setError(error.message); } });
+            header.append(remove);
+        }
+        li.append(header, body);
+        return li;
+    }
+    async load(reset) {
+        try {
+            const data = await communityFetch(`/messages${!reset && this.cursor ? `?cursor=${encodeURIComponent(this.cursor)}` : ''}`);
+            const list = this.view.querySelector('.communityMessages');
+            if (reset) list.innerHTML = '';
+            list.append(...data.items.map(item => this.renderMessage(item)));
+            this.cursor = data.nextCursor;
+            this.view.querySelector('.communityLoadMore').classList.toggle('hide', !this.cursor);
+            this.setError(data.items.length || list.children.length ? '' : 'No messages yet.');
+        } catch (error) { this.setError(error.message); }
+    }
+    async post() {
+        const input = this.view.querySelector('textarea');
+        try {
+            await communityFetch('/messages', { method: 'POST', body: JSON.stringify({ body: input.value }) });
+            input.value = ''; input.dispatchEvent(new Event('input')); await this.load(true);
+        } catch (error) { this.setError(error.message); }
+    }
+    destroy() { this.emojiPicker.destroy(); this.online.pause(); this.view.querySelector('.communityComposer')?.removeEventListener('submit', this.submit); this.view.querySelector('textarea')?.removeEventListener('input', this.input); this.view = null; }
+}
+
+/* eslint-enable @stylistic/max-statements-per-line, no-void, sonarjs/no-nested-template-literals */
